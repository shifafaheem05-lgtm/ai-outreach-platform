# Settings for a PUBLIC DEMO (free host, no database server, no real email).
# Copy these into your host's "Environment Variables" screen. Do not commit real values.
DEMO_MODE=true
APP_ENV=development
# Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=
# OPTION A (data is kept): a free hosted PostgreSQL such as Neon. Copy its connection string and change the start
# from postgresql:// to postgresql+psycopg2:// . Keep ?sslmode=require at the end.
DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST/DBNAME?sslmode=require
# OPTION B (data resets on every restart): a throwaway SQLite file inside the container.
# DATABASE_URL=sqlite:////tmp/aop-demo.db
AUTO_CREATE_TABLES=false
ENABLE_SCHEDULER=false
ALLOW_REGISTRATION=true
# Your public URL, e.g. https://ai-outreach-demo.onrender.com
PUBLIC_BASE_URL=
CORS_ORIGINS=
# Leave OPENAI_API_KEY unset on a public demo so strangers cannot spend your AI credits.

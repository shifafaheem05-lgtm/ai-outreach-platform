# ---- Core ----
APP_ENV=development
SECRET_KEY=change-me-to-a-long-random-string
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14
CORS_ORIGINS=http://localhost:5173

# ---- Database ----
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/ai_outreach_pro
# For quick local dev without Postgres:
# DATABASE_URL=sqlite:///./dev.db

# ---- Background jobs ----
REDIS_URL=redis://localhost:6379/0

# ---- LLM (any OpenAI-compatible endpoint). Leave the key empty to run without AI. ----
# Free options (free-tier limits and model names change: check the provider's site):
#   Groq:    OPENAI_BASE_URL=https://api.groq.com/openai/v1
#            OPENAI_MODEL=llama-3.1-8b-instant
#   Gemini:  OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#            OPENAI_MODEL=gemini-2.0-flash
#   Ollama (runs on your own PC, fully free, no key needed):
#            OPENAI_BASE_URL=http://localhost:11434/v1   OPENAI_MODEL=llama3.2
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# What your agency sells; used to frame "opportunities" in research reports
AGENCY_SERVICES=

# ---- Lead sources (optional, use whichever you have a licence for) ----
APOLLO_API_KEY=
HUNTER_API_KEY=
GOOGLE_PLACES_API_KEY=

# ---- Email verification (optional) ----
ZEROBOUNCE_API_KEY=

# ---- Gmail OAuth (optional) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/integrations/gmail/callback

# ---- Public URL used in unsubscribe links ----
PUBLIC_BASE_URL=http://localhost:8000

# ---- Demo seed ----
SEED_DEMO_DATA=true

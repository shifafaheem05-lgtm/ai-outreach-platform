# =====================================================================================
# PRODUCTION template (PostgreSQL). For local development use backend/.env.example instead.
# With APP_ENV=production the app REFUSES TO START unless every value below is real.
# Never commit the filled-in file. Generate secrets on the server:
#   SECRET_KEY      python -c "import secrets;print(secrets.token_urlsafe(48))"
#   ENCRYPTION_KEY  python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
# Keep ENCRYPTION_KEY safe: losing it makes stored mailbox passwords unreadable.
# =====================================================================================
APP_ENV=production
SECRET_KEY=
ENCRYPTION_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14
# Your real site origin(s), comma separated
CORS_ORIGINS=https://outreach.example.com
# false once your admin account exists; people are then added in Settings > Team
ALLOW_REGISTRATION=true

# ---- Database: PostgreSQL only (SQLite is rejected in production) ----
DATABASE_URL=postgresql+psycopg2://DB_USER:DB_PASSWORD@DB_HOST:5432/ai_outreach_pro
AUTO_CREATE_TABLES=false
SEED_DEMO_DATA=false
ENABLE_SCHEDULER=true

# ---- Public https URL (unsubscribe links are built from it) ----
PUBLIC_BASE_URL=https://outreach.example.com

# ---- LLM (any OpenAI-compatible endpoint). Leave the key empty to run without AI. ----
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
AGENCY_SERVICES=

# ---- Optional lead sources / verification ----
APOLLO_API_KEY=
HUNTER_API_KEY=
GOOGLE_PLACES_API_KEY=
ZEROBOUNCE_API_KEY=

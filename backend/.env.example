# =====================================================================================
# LOCAL DEVELOPMENT settings (SQLite, no Docker, no PostgreSQL server needed).
#
# Do NOT copy this by hand. From the backend folder run:   python scripts/make_env.py
# It creates backend/.env from this file and fills in fresh random SECRET_KEY and ENCRYPTION_KEY.
# Never commit backend/.env. For a real deployment use ../.env.production.example instead.
# =====================================================================================

# ---- Core ----
APP_ENV=development
# Filled in by scripts/make_env.py (random, per machine). Leave empty here.
SECRET_KEY=
ENCRYPTION_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14
# Vite dev server (npm run dev) origin. Not needed when you open the app on http://localhost:8000
CORS_ORIGINS=http://localhost:5173
ALLOW_REGISTRATION=true

# ---- Database: a single SQLite file inside the backend folder ----
DATABASE_URL=sqlite:///./dev.db
# false = tables are created by:  alembic upgrade head   (same migrations PostgreSQL production uses)
# true  = the app creates tables itself on start-up (quick throw-away experiments only)
AUTO_CREATE_TABLES=false

# ---- Demo data: creates demo@aioutreach.pro / Demo1234!  (development only; production refuses it) ----
SEED_DEMO_DATA=true

# ---- Background email sender (runs inside the backend process) ----
ENABLE_SCHEDULER=true

# ---- Public URL used in unsubscribe links ----
PUBLIC_BASE_URL=http://localhost:8000

# ---- LLM (any OpenAI-compatible endpoint). Leave the key empty to run without AI. ----
# Free options (limits and model names change: check the provider's site):
#   Groq:    OPENAI_BASE_URL=https://api.groq.com/openai/v1        OPENAI_MODEL=llama-3.1-8b-instant
#   Gemini:  OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/   OPENAI_MODEL=gemini-2.0-flash
#   Ollama (on your own PC, no key): OPENAI_BASE_URL=http://localhost:11434/v1   OPENAI_MODEL=llama3.2
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# What your agency sells; used to frame "opportunities" in research reports
AGENCY_SERVICES=

# ---- Optional lead sources / verification (use whichever you have a licence for) ----
APOLLO_API_KEY=
HUNTER_API_KEY=
GOOGLE_PLACES_API_KEY=
ZEROBOUNCE_API_KEY=
